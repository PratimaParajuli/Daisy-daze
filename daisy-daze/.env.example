# API listener and browser origin; match CLIENT_URL to Vite's local address.
PORT=4000
CLIENT_URL=http://localhost:5173
# MongoDB database and a private token-signing secret.
MONGODB_URI=mongodb://127.0.0.1:27017/daisy-daze
JWT_SECRET=replace-with-a-long-random-secret
# Optional first-run shop administrator account.
ADMIN_NAME=Shop Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password