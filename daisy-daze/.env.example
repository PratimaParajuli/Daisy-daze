# API listener and browser origin; match CLIENT_URL to the deployed frontend URL.
NODE_ENV=production
PORT=4000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# MongoDB database and a private token-signing secret.
MONGODB_URI=mongodb://127.0.0.1:27017/daisy-daze
JWT_SECRET=replace-with-a-long-random-secret

# Optional first-run shop administrator account.
ADMIN_NAME=Shop Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password